# Copy this file to `.env` (same folder) if you need to override defaults.
# uvicorn does not load this automatically - either `export`/set these in
# your shell before running uvicorn, or use a tool like python-dotenv /
# `uvicorn --env-file .env` if you add one.

# CORS - the Next.js dev server's origin(s), comma-separated.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Real phone-OTP login (see services/auth.py) - the SAME Firebase project ID
# as the frontend's NEXT_PUBLIC_FIREBASE_PROJECT_ID (frontend/.env.local.example).
# Verifying a Firebase ID token needs only this - no service-account JSON.
# Until this is set, POST /api/auth/verify returns 503 rather than faking a login.
FIREBASE_PROJECT_ID=
