# Copy this file to `.env.local` (same folder) before running `npm run dev`.
#
# Where the FastAPI backend is listening. Port 8001 is the project default
# because port 8000 was already taken on the machine this was built on.
# If you run uvicorn on a different port, change it here too.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
